# Database URL - PostgreSQL (primary) or SQLite (fallback)
# PostgreSQL example: postgresql://user:password@host:5432/retailiq
# SQLite fallback: sqlite:///./retailiq.db
DATABASE_URL=sqlite:///./retailiq.db

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML model artifacts directory (relative to backend root)
MODEL_DIR=app/models

# Upload settings
MAX_UPLOAD_SIZE_MB=50

# Environment
ENVIRONMENT=development
